# =============================================================================
# CONFIGURAÇÃO DE AMBIENTE — WORKFORCE ERP UNIÃO SUPERMERCADOS
# Copie este arquivo para `.env.local` (desenvolvimento) e configure no provedor
# de hospedagem em produção. NUNCA versione `.env` ou chaves `service_role`.
# =============================================================================

# Frontend (chaves públicas — segurança garantida por Supabase Auth + RLS + RPC)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_SUPABASE_ANON_KEY"
VITE_APP_ENV_LABEL="Produção — União Supermercados"

# Scripts administrativos de backend (EXCLUSIVO servidor/CLI — NUNCA expor com prefixo VITE_)
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY_SECRETA"
